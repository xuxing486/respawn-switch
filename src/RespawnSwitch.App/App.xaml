<Application x:Class="RespawnSwitch.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnStartup">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#0B0D12"/><SolidColorBrush x:Key="SurfaceBrush" Color="#151922"/>
        <SolidColorBrush x:Key="RaisedSurfaceBrush" Color="#1C222E"/><SolidColorBrush x:Key="PrimaryTextBrush" Color="#F7F8FA"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#98A2B3"/><SolidColorBrush x:Key="AccentBrush" Color="#FE2C55"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#32D583"/><SolidColorBrush x:Key="WarningBrush" Color="#FDB022"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#F97066"/><CornerRadius x:Key="CardCornerRadius">14</CornerRadius>
        <Thickness x:Key="StandardSpacing">16</Thickness><Thickness x:Key="LargeSpacing">24</Thickness>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/><Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/></Style>
        <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/><Setter Property="Background" Value="{StaticResource RaisedSurfaceBrush}"/><Setter Property="BorderBrush" Value="#344054"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#293142"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Style>
        <Style TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/><Setter Property="Background" Value="#11151D"/><Setter Property="BorderBrush" Value="#344054"/><Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/><Setter Property="Padding" Value="11,8"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#101828"/><Setter Property="Background" Value="#F7F8FA"/><Setter Property="Padding" Value="8,6"/></Style>
        <Style TargetType="ListBox"><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/><Setter Property="Background" Value="#11151D"/><Setter Property="BorderBrush" Value="#344054"/></Style>
    </Application.Resources>
</Application>
