<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RespawnSwitch.Core\RespawnSwitch.Core.csproj" />
    <ProjectReference Include="..\RespawnSwitch.Application\RespawnSwitch.Application.csproj" />
    <ProjectReference Include="..\RespawnSwitch.Riot\RespawnSwitch.Riot.csproj" />
    <ProjectReference Include="..\RespawnSwitch.Infrastructure\RespawnSwitch.Infrastructure.csproj" />
    <ProjectReference Include="..\RespawnSwitch.Windows\RespawnSwitch.Windows.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <AssemblyName>RespawnSwitch</AssemblyName>
    <RootNamespace>RespawnSwitch.App</RootNamespace>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <Product>RespawnSwitch</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

</Project>
