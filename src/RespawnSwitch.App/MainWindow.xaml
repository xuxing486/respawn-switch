<Window x:Class="RespawnSwitch.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RespawnSwitch · 复活切换" Height="720" Width="900" MinHeight="640" MinWidth="820" Background="{StaticResource AppBackground}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/><Setter Property="Padding" Value="18"/></Style>
        <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/><Setter Property="FontSize" Value="12"/></Style>
        <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,24,28,28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="RespawnSwitch" FontSize="28" FontWeight="Bold"/><TextBlock Text="阵亡时打开抖音，复活后自动回到 League" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,0"/></StackPanel>
                <Border x:Name="MonitoringStatusPill" Grid.Column="1" Background="#173D32" CornerRadius="20" Padding="14,8" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusLight" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="正在准备" FontWeight="SemiBold"/></StackPanel></Border>
            </Grid>
            <Grid Grid.Row="1" Margin="0,22,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border x:Name="LeagueStatusCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="LEAGUE" Style="{StaticResource Caption}"/><TextBlock Text="游戏检测" Style="{StaticResource CardTitle}" Margin="0,7,0,0"/><TextBlock Text="Live Client 安全轮询" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Border>
                <Border x:Name="DouyinStatusCard" Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="DOUYIN" Style="{StaticResource Caption}"/><TextBlock x:Name="DouyinStateText" Text="正在查找客户端" Style="{StaticResource CardTitle}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="DouyinPathSummary" Text="快速来源 + 本机固定磁盘" Style="{StaticResource Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                <Border x:Name="MediaStatusCard" Grid.Column="4" Style="{StaticResource Card}"><StackPanel><TextBlock Text="MEDIA" Style="{StaticResource Caption}"/><TextBlock Text="播放控制" Style="{StaticResource CardTitle}" Margin="0,7,0,0"/><TextBlock x:Name="IdentityText" Text="等待媒体会话" Style="{StaticResource Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
            </Grid>
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="抖音发现设置" Style="{StaticResource CardTitle}"/><TextBlock Text="确认真实安装位置，找不到时可使用官网" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><ComboBox x:Name="DiscoveryModeCombo" Grid.Column="1" Width="112" SelectionChanged="DiscoveryMode_SelectionChanged"><ComboBoxItem Content="自动" Tag="Auto"/><ComboBoxItem Content="手动" Tag="Manual"/><ComboBoxItem Content="仅网页版" Tag="WebOnly"/></ComboBox></Grid>
                        <Separator Margin="0,15" Background="#2B3443"/>
                        <CheckBox x:Name="AutoDetectToggle" Content="启动时扫描所有本机固定磁盘" IsChecked="True" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed"/>
                        <CheckBox x:Name="WebFallbackToggle" Content="找不到客户端时自动打开抖音网页版" IsChecked="True" Margin="0,12,0,0" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed"/>
                        <TextBlock Text="已确认路径" Style="{StaticResource Caption}" Margin="0,16,0,6"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DouyinPathText" IsReadOnly="True" Text="尚未确认" VerticalContentAlignment="Center"/><Button Grid.Column="1" Content="手动选择" Margin="10,0,0,0" Click="BrowseDouyin_Click"/></Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button x:Name="RescanButton" Content="扫描整台电脑" Style="{StaticResource PrimaryButton}" Click="Rescan_Click"/><Button x:Name="CancelScanButton" Content="取消扫描" Margin="10,0,0,0" Click="CancelScan_Click"/></StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="扫描状态" Style="{StaticResource CardTitle}"/><StackPanel Grid.Row="1" Margin="0,12,0,12"><ProgressBar x:Name="DiscoveryProgressBar" Height="5" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Background="#2B3443"/><TextBlock x:Name="DiscoveryProgressText" Text="准备扫描…" Style="{StaticResource Caption}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><ListBox x:Name="CandidateList" Grid.Row="2" MinHeight="112" MaxHeight="170" SelectionChanged="CandidateList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,6"><TextBlock Text="{Binding ProductName}" FontWeight="SemiBold"/><TextBlock Text="{Binding NormalizedPath}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
                </Border>
            </Grid>
            <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="开始监控" Style="{StaticResource PrimaryButton}" Click="Start_Click"/><Button Grid.Column="1" Content="停止监控" Margin="10,0,0,0" Click="Stop_Click"/><Button Grid.Column="2" Content="预览悬浮倒计时" Margin="10,0,0,0" Click="TestOverlay_Click"/></Grid>
            <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,16,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="90"/></Grid.RowDefinitions><TextBlock Text="事件记录" Style="{StaticResource CardTitle}"/><ListBox x:Name="EventLog" Grid.Row="1" Margin="0,10,0,0" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="11"/></Grid></Border>
        </Grid>
    </ScrollViewer>
</Window>
