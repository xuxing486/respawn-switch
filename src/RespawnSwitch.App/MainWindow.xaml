<Window x:Class="RespawnSwitch.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RespawnSwitch · 复活切换" Height="690" Width="940" MinHeight="620" MinWidth="860" Background="{StaticResource AppBackground}" WindowStartupLocation="CenterScreen">
 <Window.Resources><Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="20"/><Setter Property="BorderBrush" Value="#202735"/><Setter Property="BorderThickness" Value="1"/></Style><Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/><Setter Property="FontSize" Value="12"/></Style><Style x:Key="Value" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/></Style></Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="30,26,30,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="RespawnSwitch" FontSize="29" FontWeight="Bold"/><TextBlock Text="赛前确认连接，阵亡时看抖音，复活后自动返回" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,0"/></StackPanel><Border Grid.Column="1" x:Name="OverallStatusPill" Background="#1B2531" CornerRadius="22" Padding="16,10" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse x:Name="OverallStatusLight" Width="9" Height="9" Fill="{StaticResource WarningBrush}" Margin="0,0,9,0"/><TextBlock x:Name="OverallStatusText" Text="正在进行赛前检查" FontWeight="SemiBold"/></StackPanel></Border></Grid>
  <Grid Grid.Row="1" Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border x:Name="LeagueStatusCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="LEAGUE" Style="{StaticResource Label}"/><TextBlock Text="游戏连接" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,14"/><TextBlock Text="客户端" Style="{StaticResource Label}"/><TextBlock x:Name="LeagueClientStateText" Text="正在检测" Style="{StaticResource Value}" Margin="0,3,0,11"/><TextBlock Text="对局数据" Style="{StaticResource Label}"/><TextBlock x:Name="LeagueGameDataStateText" Text="等待进入游戏" Style="{StaticResource Value}"/></StackPanel></Border>
   <Border x:Name="DouyinStatusCard" Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="DOUYIN" Style="{StaticResource Label}"/><TextBlock Text="抖音目标" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,12"/><ComboBox x:Name="DouyinTargetCombo" SelectionChanged="DouyinTarget_Changed"><ComboBoxItem Content="自动选择" Tag="Auto"/><ComboBoxItem Content="桌面客户端" Tag="Manual"/><ComboBoxItem Content="Chrome / Edge 网页" Tag="WebOnly"/></ComboBox><TextBlock x:Name="DouyinStateText" Text="请提前打开抖音" Style="{StaticResource Value}" Margin="0,12,0,0" TextWrapping="Wrap"/><TextBlock x:Name="MediaStateText" Text="播放控制等待连接" Style="{StaticResource Label}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border>
   <Border x:Name="AutomationStatusCard" Grid.Column="4" Style="{StaticResource Card}"><StackPanel><TextBlock Text="AUTOMATION" Style="{StaticResource Label}"/><TextBlock Text="自动流程" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,14"/><TextBlock x:Name="AutomationStateText" Text="悬浮层与本地计时已就绪" Style="{StaticResource Value}" TextWrapping="Wrap"/><TextBlock Text="无边框 · 不抢焦点 · 100ms 刷新" Style="{StaticResource Label}" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Border>
  </Grid>
  <Border x:Name="IssuePanel" Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Background="#241B20" BorderBrush="#55323B"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#4A2631" CornerRadius="18" Width="36" Height="36"><TextBlock Text="!" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F97066"/></Border><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="连接诊断" FontWeight="SemiBold"/><TextBlock x:Name="IssueText" Text="正在检查 League 客户端和抖音目标…" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Grid></Border>
  <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="RetestButton" Content="重新检测连接" Style="{StaticResource PrimaryButton}" Click="Retest_Click"/><Button x:Name="TestOverlayButton" Content="预览英雄与倒计时" Margin="10,0,0,0" Click="TestOverlay_Click"/><Button Content="停止监控" Margin="10,0,0,0" Click="Stop_Click"/></StackPanel><TextBlock Grid.Column="1" Text="使用前请先打开抖音视频" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/></Grid>
  <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,16,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="100"/></Grid.RowDefinitions><TextBlock Text="最近事件" FontWeight="SemiBold"/><ListBox x:Name="EventLog" Grid.Row="1" Margin="0,10,0,0" BorderThickness="0" Background="Transparent"/></Grid></Border>
 </Grid></ScrollViewer>
</Window>
